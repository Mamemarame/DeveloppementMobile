<?xml version="1.0" encoding="utf-8"?>
<!--
    item_revenu.xml
    Layout d'un seul élément dans la liste des revenus.
    Chaque revenu apparaît sous forme de carte (CardView).
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp">

    <!-- Contenu horizontal : emoji | infos | montant -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Emoji représentant la source du revenu -->
        <TextView
            android:id="@+id/tvIconeSource"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:textSize="22sp"
            android:layout_marginEnd="12dp"
            android:background="#E8F5E9"
            android:text="💰"/>

        <!-- Bloc central : source + description + date -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Source du revenu : Salaire, Commerce... -->
            <TextView
                android:id="@+id/tvSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="Salaire"/>

            <!-- Description optionnelle -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#888888"
                android:text="Description"/>

            <!-- Date au format JJ/MM/AAAA -->
            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#AAAAAA"
                android:text="01/04/2025"/>

        </LinearLayout>

        <!-- Montant du revenu affiché en vert -->
        <TextView
            android:id="@+id/tvMontant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:text="+50 000 FCFA"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>